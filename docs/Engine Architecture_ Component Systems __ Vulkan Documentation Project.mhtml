<div class=3D"sect2">
<h3 id=3D"_component_communication"><a class=3D"anchor" href=3D"https://doc=
s.vulkan.org/tutorial/latest/Building_a_Simple_Engine/Engine_Architecture/0=
3_component_systems.html#_component_communication"></a>Component Communicat=
ion</h3>
<div class=3D"paragraph">
<p>Components often need to communicate with each other. There are several =
approaches to component communication:</p>
</div>
<div class=3D"sect3">
<h4 id=3D"_direct_references"><a class=3D"anchor" href=3D"https://docs.vulk=
an.org/tutorial/latest/Building_a_Simple_Engine/Engine_Architecture/03_comp=
onent_systems.html#_direct_references"></a>Direct References</h4>
<div class=3D"paragraph">
<p>The simplest approach is to use direct references:</p>
</div>
<div class=3D"listingblock">
<div class=3D"content">
<pre class=3D"highlightjs highlight"><code class=3D"language-cpp hljs" data=
-lang=3D"cpp"><span class=3D"hljs-function"><span class=3D"hljs-keyword">vo=
id</span> <span class=3D"hljs-title">MeshComponent::Update</span><span clas=
s=3D"hljs-params">(<span class=3D"hljs-keyword">float</span> deltaTime)</sp=
an> </span>{
    <span class=3D"hljs-keyword">auto</span> transform =3D GetOwner()-&gt;G=
etComponent&lt;TransformComponent&gt;();
    <span class=3D"hljs-keyword">if</span> (transform) {
        <span class=3D"hljs-comment">// Use transform data</span>
    }
}</code></pre>
<div class=3D"source-toolbox"><span class=3D"source-lang">cpp</span><button=
 class=3D"copy-button" title=3D"Copy to clipboard"><img src=3D"https://docs=
.vulkan.org/_/img/octicons-16.svg#view-clippy" alt=3D"copy icon" class=3D"c=
opy-icon" width=3D"13" height=3D"13"><span class=3D"copy-toast">Copied!</sp=
an></button></div></div>
</div>
<div class=3D"paragraph">
<p>This approach is straightforward but creates tight coupling between
components.  Tight coupling makes it challenging or impossible to create
unit tests and properly test the engine, so this approach should be avoided
in production code.</p>
</div>
</div>
<div class=3D"sect3">
<h4 id=3D"_event_system"><a class=3D"anchor" href=3D"https://docs.vulkan.or=
g/tutorial/latest/Building_a_Simple_Engine/Engine_Architecture/03_component=
_systems.html#_event_system"></a>Event System</h4>
<div class=3D"paragraph">
<p>A more flexible approach is to use an event system:</p>
</div>
<div class=3D"listingblock">
<div class=3D"content">
<pre class=3D"highlightjs highlight"><code class=3D"language-cpp hljs" data=
-lang=3D"cpp"><span class=3D"hljs-comment">// Event base class</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">Event</span> {</span>
<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-keyword">virtual</span> ~Event() =3D <span class=3D=
"hljs-keyword">default</span>;
};

<span class=3D"hljs-comment">// Specific event types</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">CollisionEvent</span> :</span> <span class=3D"hljs-key=
word">public</span> Event {
<span class=3D"hljs-keyword">private</span>:
    Entity* entity1;
    Entity* entity2;

<span class=3D"hljs-keyword">public</span>:
    CollisionEvent(Entity* e1, Entity* e2) : entity1(e1), entity2(e2) {}

    <span class=3D"hljs-function">Entity* <span class=3D"hljs-title">GetEnt=
ity1</span><span class=3D"hljs-params">()</span> <span class=3D"hljs-keywor=
d">const</span> </span>{ <span class=3D"hljs-keyword">return</span> entity1=
; }
    <span class=3D"hljs-function">Entity* <span class=3D"hljs-title">GetEnt=
ity2</span><span class=3D"hljs-params">()</span> <span class=3D"hljs-keywor=
d">const</span> </span>{ <span class=3D"hljs-keyword">return</span> entity2=
; }
};

<span class=3D"hljs-comment">// Event listener interface</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">EventListener</span> {</span>
<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-keyword">virtual</span> ~EventListener() =3D <span =
class=3D"hljs-keyword">default</span>;
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">virtual</spa=
n> <span class=3D"hljs-keyword">void</span> <span class=3D"hljs-title">OnEv=
ent</span><span class=3D"hljs-params">(<span class=3D"hljs-keyword">const</=
span> Event&amp; event)</span> </span>=3D <span class=3D"hljs-number">0</sp=
an>;
};

<span class=3D"hljs-comment">// Event system</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">EventSystem</span> {</span>
<span class=3D"hljs-keyword">private</span>:
    <span class=3D"hljs-built_in">std</span>::<span class=3D"hljs-built_in"=
>vector</span>&lt;EventListener*&gt; listeners;

<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">AddListener</span><span class=3D"hljs-params">(E=
ventListener* listener)</span> </span>{
        listeners.push_back(listener);
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">RemoveListener</span><span class=3D"hljs-params"=
>(EventListener* listener)</span> </span>{
        <span class=3D"hljs-keyword">auto</span> it =3D <span class=3D"hljs=
-built_in">std</span>::find(listeners.begin(), listeners.end(), listener);
        <span class=3D"hljs-keyword">if</span> (it !=3D listeners.end()) {
            listeners.erase(it);
        }
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">DispatchEvent</span><span class=3D"hljs-params">=
(<span class=3D"hljs-keyword">const</span> Event&amp; event)</span> </span>=
{
        <span class=3D"hljs-keyword">for</span> (<span class=3D"hljs-keywor=
d">auto</span> listener : listeners) {
            listener-&gt;OnEvent(event);
        }
    }
};

<span class=3D"hljs-comment">// Component that listens for events</span>
<span class=3D"hljs-comment">// Handles physics-related behavior and respon=
ds to collision events through the event system</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">PhysicsComponent</span> :</span> <span class=3D"hljs-k=
eyword">public</span> Component, <span class=3D"hljs-keyword">public</span>=
 EventListener {
<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">Initialize</span><span class=3D"hljs-params">()<=
/span> <span class=3D"hljs-keyword">override</span> </span>{
        <span class=3D"hljs-comment">// Register as event listener</span>
        GetEventSystem().AddListener(<span class=3D"hljs-keyword">this</spa=
n>);
    }

    ~PhysicsComponent() <span class=3D"hljs-keyword">override</span> {
        <span class=3D"hljs-comment">// Unregister as event listener</span>
        GetEventSystem().RemoveListener(<span class=3D"hljs-keyword">this</=
span>);
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">OnEvent</span><span class=3D"hljs-params">(<span=
 class=3D"hljs-keyword">const</span> Event&amp; event)</span> <span class=
=3D"hljs-keyword">override</span> </span>{
        <span class=3D"hljs-keyword">if</span> (<span class=3D"hljs-keyword=
">auto</span> collisionEvent =3D <span class=3D"hljs-keyword">dynamic_cast<=
/span>&lt;<span class=3D"hljs-keyword">const</span> CollisionEvent*&gt;(&am=
p;event)) {
            <span class=3D"hljs-comment">// Handle collision event</span>
        }
    }

<span class=3D"hljs-keyword">private</span>:
    <span class=3D"hljs-function">EventSystem&amp; <span class=3D"hljs-titl=
e">GetEventSystem</span><span class=3D"hljs-params">()</span> </span>{
        <span class=3D"hljs-comment">// Get event system from somewhere (e.=
g., service locator)</span>
        <span class=3D"hljs-keyword">static</span> EventSystem eventSystem;
        <span class=3D"hljs-keyword">return</span> eventSystem;
    }
};</code></pre>
<div class=3D"source-toolbox"><span class=3D"source-lang">cpp</span><button=
 class=3D"copy-button" title=3D"Copy to clipboard"><img src=3D"https://docs=
.vulkan.org/_/img/octicons-16.svg#view-clippy" alt=3D"copy icon" class=3D"c=
opy-icon" width=3D"13" height=3D"13"><span class=3D"copy-toast">Copied!</sp=
an></button></div></div>
</div>
<div class=3D"paragraph">
<p>This approach decouples components but adds complexity.  Crucially, a
decoupled component is a component that can be tested independently of any
other component.</p>
</div>
</div>
</div>
<div class=3D"sect2">
<h3 id=3D"_component_lifecycle_management"><a class=3D"anchor" href=3D"http=
s://docs.vulkan.org/tutorial/latest/Building_a_Simple_Engine/Engine_Archite=
cture/03_component_systems.html#_component_lifecycle_management"></a>Compon=
ent Lifecycle Management</h3>
<div class=3D"paragraph">
<p>Managing the lifecycle of components is crucial for a robust component s=
ystem:</p>
</div>
<div class=3D"listingblock">
<div class=3D"content">
<pre class=3D"highlightjs highlight"><code class=3D"language-cpp hljs" data=
-lang=3D"cpp"><span class=3D"hljs-class"><span class=3D"hljs-keyword">class=
</span> <span class=3D"hljs-title">Component</span> {</span>
<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-keyword">enum</span> <span class=3D"hljs-class"><sp=
an class=3D"hljs-keyword">class</span> <span class=3D"hljs-title">State</sp=
an> {</span>
        Uninitialized,
        Initializing,
        Active,
        Destroying,
        Destroyed
    };

<span class=3D"hljs-keyword">private</span>:
    State state =3D State::Uninitialized;
    Entity* owner =3D <span class=3D"hljs-literal">nullptr</span>;

<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-keyword">virtual</span> ~Component() {
        <span class=3D"hljs-keyword">if</span> (state !=3D State::Destroyed=
) {
            OnDestroy();
            state =3D State::Destroyed;
        }
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">Initialize</span><span class=3D"hljs-params">()<=
/span> </span>{
        <span class=3D"hljs-keyword">if</span> (state =3D=3D State::Uniniti=
alized) {
            state =3D State::Initializing;
            OnInitialize();
            state =3D State::Active;
        }
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">Destroy</span><span class=3D"hljs-params">()</sp=
an> </span>{
        <span class=3D"hljs-keyword">if</span> (state =3D=3D State::Active)=
 {
            state =3D State::Destroying;
            OnDestroy();
            state =3D State::Destroyed;
        }
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">bool</span> =
<span class=3D"hljs-title">IsActive</span><span class=3D"hljs-params">()</s=
pan> <span class=3D"hljs-keyword">const</span> </span>{ <span class=3D"hljs=
-keyword">return</span> state =3D=3D State::Active; }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">SetOwner</span><span class=3D"hljs-params">(Enti=
ty* entity)</span> </span>{ owner =3D entity; }
    <span class=3D"hljs-function">Entity* <span class=3D"hljs-title">GetOwn=
er</span><span class=3D"hljs-params">()</span> <span class=3D"hljs-keyword"=
>const</span> </span>{ <span class=3D"hljs-keyword">return</span> owner; }

<span class=3D"hljs-keyword">protected</span>:
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">virtual</spa=
n> <span class=3D"hljs-keyword">void</span> <span class=3D"hljs-title">OnIn=
itialize</span><span class=3D"hljs-params">()</span> </span>{}
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">virtual</spa=
n> <span class=3D"hljs-keyword">void</span> <span class=3D"hljs-title">OnDe=
stroy</span><span class=3D"hljs-params">()</span> </span>{}
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">virtual</spa=
n> <span class=3D"hljs-keyword">void</span> <span class=3D"hljs-title">Upda=
te</span><span class=3D"hljs-params">(<span class=3D"hljs-keyword">float</s=
pan> deltaTime)</span> </span>{}
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">virtual</spa=
n> <span class=3D"hljs-keyword">void</span> <span class=3D"hljs-title">Rend=
er</span><span class=3D"hljs-params">()</span> </span>{}

    <span class=3D"hljs-keyword">friend</span> <span class=3D"hljs-class"><=
span class=3D"hljs-keyword">class</span> <span class=3D"hljs-title">Entity<=
/span>;</span> <span class=3D"hljs-comment">// Allow Entity to call protect=
ed methods</span>
};</code></pre>
