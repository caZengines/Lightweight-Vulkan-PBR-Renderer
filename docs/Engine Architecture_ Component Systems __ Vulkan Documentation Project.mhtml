<div class=3D"sect2">
<h3 id=3D"_common_component_types"><a class=3D"anchor" href=3D"https://docs=
.vulkan.org/tutorial/latest/Building_a_Simple_Engine/Engine_Architecture/03=
_component_systems.html#_common_component_types"></a>Common Component Types=
</h3>
<div class=3D"paragraph">
<p>Let=E2=80=99s implement some common component types that you might use i=
n a rendering engine:</p>
</div>
<div class=3D"listingblock">
<div class=3D"content">
<pre class=3D"highlightjs highlight"><code class=3D"language-cpp hljs" data=
-lang=3D"cpp"><span class=3D"hljs-comment">// Transform component</span>
<span class=3D"hljs-comment">// Handles the position, rotation, and scale o=
f an entity in 3D space</span>
<span class=3D"hljs-comment">// AffineTransform or "Pose" matrix.</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">TransformComponent</span> :</span> <span class=3D"hljs=
-keyword">public</span> Component {
<span class=3D"hljs-keyword">private</span>:
    glm::vec3 position =3D glm::vec3(<span class=3D"hljs-number">0.0f</span=
>);
    glm::quat rotation =3D glm::quat(<span class=3D"hljs-number">1.0f</span=
>, <span class=3D"hljs-number">0.0f</span>, <span class=3D"hljs-number">0.0=
f</span>, <span class=3D"hljs-number">0.0f</span>); <span class=3D"hljs-com=
ment">// Identity quaternion</span>
    glm::vec3 scale =3D glm::vec3(<span class=3D"hljs-number">1.0f</span>);

    <span class=3D"hljs-comment">// Cached transformation matrix</span>
    <span class=3D"hljs-keyword">mutable</span> glm::mat4 transformMatrix =
=3D glm::mat4(<span class=3D"hljs-number">1.0f</span>);
    <span class=3D"hljs-keyword">mutable</span> <span class=3D"hljs-keyword=
">bool</span> transformDirty =3D <span class=3D"hljs-literal">true</span>;

<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">SetPosition</span><span class=3D"hljs-params">(<=
span class=3D"hljs-keyword">const</span> glm::vec3&amp; pos)</span> </span>=
{
        position =3D pos;
        transformDirty =3D <span class=3D"hljs-literal">true</span>;
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">SetRotation</span><span class=3D"hljs-params">(<=
span class=3D"hljs-keyword">const</span> glm::quat&amp; rot)</span> </span>=
{
        rotation =3D rot;
        transformDirty =3D <span class=3D"hljs-literal">true</span>;
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">SetScale</span><span class=3D"hljs-params">(<spa=
n class=3D"hljs-keyword">const</span> glm::vec3&amp; s)</span> </span>{
        scale =3D s;
        transformDirty =3D <span class=3D"hljs-literal">true</span>;
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">const</span>=
 glm::vec3&amp; <span class=3D"hljs-title">GetPosition</span><span class=3D=
"hljs-params">()</span> <span class=3D"hljs-keyword">const</span> </span>{ =
<span class=3D"hljs-keyword">return</span> position; }
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">const</span>=
 glm::quat&amp; <span class=3D"hljs-title">GetRotation</span><span class=3D=
"hljs-params">()</span> <span class=3D"hljs-keyword">const</span> </span>{ =
<span class=3D"hljs-keyword">return</span> rotation; }
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">const</span>=
 glm::vec3&amp; <span class=3D"hljs-title">GetScale</span><span class=3D"hl=
js-params">()</span> <span class=3D"hljs-keyword">const</span> </span>{ <sp=
an class=3D"hljs-keyword">return</span> scale; }

    <span class=3D"hljs-function">glm::mat4 <span class=3D"hljs-title">GetT=
ransformMatrix</span><span class=3D"hljs-params">()</span> <span class=3D"h=
ljs-keyword">const</span> </span>{
        <span class=3D"hljs-keyword">if</span> (transformDirty) {
            <span class=3D"hljs-comment">// Calculate transformation matrix=
</span>
            glm::mat4 translationMatrix =3D glm::translate(glm::mat4(<span =
class=3D"hljs-number">1.0f</span>), position);
            glm::mat4 rotationMatrix =3D glm::mat4_cast(rotation);
            glm::mat4 scaleMatrix =3D glm::scale(glm::mat4(<span class=3D"h=
ljs-number">1.0f</span>), scale);

            transformMatrix =3D translationMatrix * rotationMatrix * scaleM=
atrix;
            transformDirty =3D <span class=3D"hljs-literal">false</span>;
        }
        <span class=3D"hljs-keyword">return</span> transformMatrix;
    }
};

<span class=3D"hljs-comment">// Mesh component</span>
<span class=3D"hljs-comment">// Manages the visual representation of an ent=
ity by handling its 3D mesh and material</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">MeshComponent</span> :</span> <span class=3D"hljs-keyw=
ord">public</span> Component {
<span class=3D"hljs-keyword">private</span>:
    Mesh* mesh =3D <span class=3D"hljs-literal">nullptr</span>;
    Material* material =3D <span class=3D"hljs-literal">nullptr</span>;

<span class=3D"hljs-keyword">public</span>:
    MeshComponent(Mesh* m, Material* mat) : mesh(m), material(mat) {}

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">SetMesh</span><span class=3D"hljs-params">(Mesh*=
 m)</span> </span>{ mesh =3D m; }
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">SetMaterial</span><span class=3D"hljs-params">(M=
aterial* mat)</span> </span>{ material =3D mat; }

    <span class=3D"hljs-function">Mesh* <span class=3D"hljs-title">GetMesh<=
/span><span class=3D"hljs-params">()</span> <span class=3D"hljs-keyword">co=
nst</span> </span>{ <span class=3D"hljs-keyword">return</span> mesh; }
    <span class=3D"hljs-function">Material* <span class=3D"hljs-title">GetM=
aterial</span><span class=3D"hljs-params">()</span> <span class=3D"hljs-key=
word">const</span> </span>{ <span class=3D"hljs-keyword">return</span> mate=
rial; }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">Render</span><span class=3D"hljs-params">()</spa=
n> <span class=3D"hljs-keyword">override</span> </span>{
        <span class=3D"hljs-keyword">if</span> (!mesh || !material) <span c=
lass=3D"hljs-keyword">return</span>;

        <span class=3D"hljs-comment">// Get transform component</span>
        <span class=3D"hljs-keyword">auto</span> transform =3D GetOwner()-&=
gt;GetComponent&lt;TransformComponent&gt;();
        <span class=3D"hljs-keyword">if</span> (!transform) <span class=3D"=
hljs-keyword">return</span>;

        <span class=3D"hljs-comment">// Render mesh with material and trans=
form</span>
        material-&gt;Bind();
        material-&gt;SetUniform(<span class=3D"hljs-string">"modelMatrix"</=
span>, transform-&gt;GetTransformMatrix());
        mesh-&gt;Render();
    }
};

<span class=3D"hljs-comment">// Camera component</span>
<span class=3D"hljs-comment">// Defines a viewpoint for rendering the scene=
 by managing view and projection matrices</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">CameraComponent</span> :</span> <span class=3D"hljs-ke=
yword">public</span> Component {
<span class=3D"hljs-keyword">private</span>:
    <span class=3D"hljs-keyword">float</span> fieldOfView =3D <span class=
=3D"hljs-number">45.0f</span>;
    <span class=3D"hljs-keyword">float</span> aspectRatio =3D <span class=
=3D"hljs-number">16.0f</span> / <span class=3D"hljs-number">9.0f</span>;
    <span class=3D"hljs-keyword">float</span> nearPlane =3D <span class=3D"=
hljs-number">0.1f</span>;
    <span class=3D"hljs-keyword">float</span> farPlane =3D <span class=3D"h=
ljs-number">1000.0f</span>;

    glm::mat4 viewMatrix =3D glm::mat4(<span class=3D"hljs-number">1.0f</sp=
an>);
    glm::mat4 projectionMatrix =3D glm::mat4(<span class=3D"hljs-number">1.=
0f</span>);
    <span class=3D"hljs-keyword">bool</span> projectionDirty =3D <span clas=
s=3D"hljs-literal">true</span>;

<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">void</span> =
<span class=3D"hljs-title">SetPerspective</span><span class=3D"hljs-params"=
>(<span class=3D"hljs-keyword">float</span> fov, <span class=3D"hljs-keywor=
d">float</span> aspect, <span class=3D"hljs-keyword">float</span> near, <sp=
an class=3D"hljs-keyword">float</span> far)</span> </span>{
        fieldOfView =3D fov;
        aspectRatio =3D aspect;
        nearPlane =3D near;
        farPlane =3D far;
        projectionDirty =3D <span class=3D"hljs-literal">true</span>;
    }

    <span class=3D"hljs-function">glm::mat4 <span class=3D"hljs-title">GetV=
iewMatrix</span><span class=3D"hljs-params">()</span> <span class=3D"hljs-k=
eyword">const</span> </span>{
        <span class=3D"hljs-comment">// Get transform component</span>
        <span class=3D"hljs-keyword">auto</span> transform =3D GetOwner()-&=
gt;GetComponent&lt;TransformComponent&gt;();
        <span class=3D"hljs-keyword">if</span> (transform) {
            <span class=3D"hljs-comment">// Calculate view matrix from tran=
sform</span>
            glm::vec3 position =3D transform-&gt;GetPosition();
            glm::quat rotation =3D transform-&gt;GetRotation();

            <span class=3D"hljs-comment">// Forward vector (local -Z)</span=
>
            glm::vec3 forward =3D rotation * glm::vec3(<span class=3D"hljs-=
number">0.0f</span>, <span class=3D"hljs-number">0.0f</span>, <span class=
=3D"hljs-number">-1.0f</span>);
            <span class=3D"hljs-comment">// Up vector (local +Y)</span>
            glm::vec3 up =3D rotation * glm::vec3(<span class=3D"hljs-numbe=
r">0.0f</span>, <span class=3D"hljs-number">1.0f</span>, <span class=3D"hlj=
s-number">0.0f</span>);

            <span class=3D"hljs-keyword">return</span> glm::lookAt(position=
, position + forward, up);
        }
        <span class=3D"hljs-keyword">return</span> glm::mat4(<span class=3D=
"hljs-number">1.0f</span>);
    }

    <span class=3D"hljs-function">glm::mat4 <span class=3D"hljs-title">GetP=
rojectionMatrix</span><span class=3D"hljs-params">()</span> <span class=3D"=
hljs-keyword">const</span> </span>{
        <span class=3D"hljs-keyword">if</span> (projectionDirty) {
            projectionMatrix =3D glm::perspective(
                glm::radians(fieldOfView),
                aspectRatio,
                nearPlane,
                farPlane
            );
            projectionDirty =3D <span class=3D"hljs-literal">false</span>;
        }
        <span class=3D"hljs-keyword">return</span> projectionMatrix;
    }
};</code></pre>
