<div class=3D"sect2">
<h3 id=3D"_optimizing_component_access"><a class=3D"anchor" href=3D"https:/=
/docs.vulkan.org/tutorial/latest/Building_a_Simple_Engine/Engine_Architectu=
re/03_component_systems.html#_optimizing_component_access"></a>Optimizing C=
omponent Access</h3>
<div class=3D"paragraph">
<p>The <code>GetComponent&lt;T&gt;()</code> method shown earlier uses dynam=
ic_cast, which can be slow. Here=E2=80=99s an optimized approach using comp=
onent type IDs:</p>
</div>
<div class=3D"listingblock">
<div class=3D"content">
<pre class=3D"highlightjs highlight"><code class=3D"language-cpp hljs" data=
-lang=3D"cpp"><span class=3D"hljs-comment">// Component type ID system</spa=
n>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">ComponentTypeIDSystem</span> {</span>
<span class=3D"hljs-keyword">private</span>:
    <span class=3D"hljs-keyword">static</span> <span class=3D"hljs-keyword"=
>size_t</span> nextTypeID;

<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">template</sp=
an>&lt;<span class=3D"hljs-keyword">typename</span> T&gt;
    <span class=3D"hljs-keyword">static</span> <span class=3D"hljs-keyword"=
>size_t</span> <span class=3D"hljs-title">GetTypeID</span><span class=3D"hl=
js-params">()</span> </span>{
        <span class=3D"hljs-keyword">static</span> <span class=3D"hljs-keyw=
ord">size_t</span> typeID =3D nextTypeID++;
        <span class=3D"hljs-keyword">return</span> typeID;
    }
};

<span class=3D"hljs-keyword">size_t</span> ComponentTypeIDSystem::nextTypeI=
D =3D <span class=3D"hljs-number">0</span>;

<span class=3D"hljs-comment">// Component base class with type ID</span>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">Component</span> {</span>
<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-keyword">virtual</span> ~Component() =3D <span clas=
s=3D"hljs-keyword">default</span>;

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">template</sp=
an>&lt;<span class=3D"hljs-keyword">typename</span> T&gt;
    <span class=3D"hljs-keyword">static</span> <span class=3D"hljs-keyword"=
>size_t</span> <span class=3D"hljs-title">GetTypeID</span><span class=3D"hl=
js-params">()</span> </span>{
        <span class=3D"hljs-keyword">return</span> ComponentTypeIDSystem::G=
etTypeID&lt;T&gt;();
    }
};

<span class=3D"hljs-comment">// Entity with optimized component access</spa=
n>
<span class=3D"hljs-class"><span class=3D"hljs-keyword">class</span> <span =
class=3D"hljs-title">Entity</span> {</span>
<span class=3D"hljs-keyword">private</span>:
    <span class=3D"hljs-built_in">std</span>::<span class=3D"hljs-built_in"=
>vector</span>&lt;<span class=3D"hljs-built_in">std</span>::<span class=3D"=
hljs-built_in">unique_ptr</span>&lt;Component&gt;&gt; components;
    <span class=3D"hljs-built_in">std</span>::<span class=3D"hljs-built_in"=
>unordered_map</span>&lt;<span class=3D"hljs-keyword">size_t</span>, Compon=
ent*&gt; componentMap;

<span class=3D"hljs-keyword">public</span>:
    <span class=3D"hljs-function"><span class=3D"hljs-keyword">template</sp=
an>&lt;<span class=3D"hljs-keyword">typename</span> T, <span class=3D"hljs-=
keyword">typename</span>... Args&gt;
    T* <span class=3D"hljs-title">AddComponent</span><span class=3D"hljs-pa=
rams">(Args&amp;&amp;... args)</span> </span>{
        <span class=3D"hljs-keyword">static_assert</span>(<span class=3D"hl=
js-built_in">std</span>::is_base_of&lt;Component, T&gt;::value, <span class=
=3D"hljs-string">"T must derive from Component"</span>);

        <span class=3D"hljs-keyword">size_t</span> typeID =3D Component::Ge=
tTypeID&lt;T&gt;();

        <span class=3D"hljs-comment">// Check if component of this type alr=
eady exists</span>
        <span class=3D"hljs-keyword">auto</span> it =3D componentMap.find(t=
ypeID);
        <span class=3D"hljs-keyword">if</span> (it !=3D componentMap.end())=
 {
            <span class=3D"hljs-keyword">return</span> <span class=3D"hljs-=
keyword">static_cast</span>&lt;T*&gt;(it-&gt;second);
        }

        <span class=3D"hljs-comment">// Create new component</span>
        <span class=3D"hljs-keyword">auto</span> component =3D <span class=
=3D"hljs-built_in">std</span>::make_unique&lt;T&gt;(<span class=3D"hljs-bui=
lt_in">std</span>::forward&lt;Args&gt;(args)...);
        T* componentPtr =3D component.get();
        componentMap[typeID] =3D componentPtr;
        components.push_back(<span class=3D"hljs-built_in">std</span>::move=
(component));
        <span class=3D"hljs-keyword">return</span> componentPtr;
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">template</sp=
an>&lt;<span class=3D"hljs-keyword">typename</span> T&gt;
    T* <span class=3D"hljs-title">GetComponent</span><span class=3D"hljs-pa=
rams">()</span> </span>{
        <span class=3D"hljs-keyword">size_t</span> typeID =3D Component::Ge=
tTypeID&lt;T&gt;();
        <span class=3D"hljs-keyword">auto</span> it =3D componentMap.find(t=
ypeID);
        <span class=3D"hljs-keyword">if</span> (it !=3D componentMap.end())=
 {
            <span class=3D"hljs-keyword">return</span> <span class=3D"hljs-=
keyword">static_cast</span>&lt;T*&gt;(it-&gt;second);
        }
        <span class=3D"hljs-keyword">return</span> <span class=3D"hljs-lite=
ral">nullptr</span>;
    }

    <span class=3D"hljs-function"><span class=3D"hljs-keyword">template</sp=
an>&lt;<span class=3D"hljs-keyword">typename</span> T&gt;
    <span class=3D"hljs-keyword">bool</span> <span class=3D"hljs-title">Rem=
oveComponent</span><span class=3D"hljs-params">()</span> </span>{
        <span class=3D"hljs-keyword">size_t</span> typeID =3D Component::Ge=
tTypeID&lt;T&gt;();
        <span class=3D"hljs-keyword">auto</span> it =3D componentMap.find(t=
ypeID);
        <span class=3D"hljs-keyword">if</span> (it !=3D componentMap.end())=
 {
            Component* componentPtr =3D it-&gt;second;
            componentMap.erase(it);

            <span class=3D"hljs-keyword">for</span> (<span class=3D"hljs-ke=
yword">auto</span> compIt =3D components.begin(); compIt !=3D components.en=
d(); ++compIt) {
                <span class=3D"hljs-keyword">if</span> (compIt-&gt;get() =
=3D=3D componentPtr) {
                    components.erase(compIt);
                    <span class=3D"hljs-keyword">return</span> <span class=
=3D"hljs-literal">true</span>;
                }
            }
        }
        <span class=3D"hljs-keyword">return</span> <span class=3D"hljs-lite=
ral">false</span>;
    }
};</code></pre>
