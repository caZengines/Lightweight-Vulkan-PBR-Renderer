---
# 自查命令（工作区根目录，应输出 "All checks completed, 0 errors"）：
#   clangd --check=src/app/app.cpp ^
#          --compile-commands-dir=cmake-build-Debug ^
#          "--query-driver=C:/msys64/ucrt64/bin/g++.exe,C:/msys64/ucrt64/bin/gcc.exe" ^
#          --background-index=false

Diagnostics:
  Suppress:
    # mingw-w64 的 xmmintrin.h 定义了 _mm_getcsr，clang 把它注册为
    # TARGET_HEADER_BUILTIN -> 解析 stb_image.h 间接包含的 emmintrin.h 时误报
    # "definition of builtin function"。GCC 接受该定义，属 clang 侧假阳性。
    - builtin_definition
